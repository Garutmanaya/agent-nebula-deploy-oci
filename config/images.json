{
  "schema_version": 1,
  "defaults": {
    "platforms": ["linux/arm64"]
  },
  "images": [
    {
      "name": "policy",
      "repository": "agent-nebula-policy",
      "image": "nebula-policy",
      "dockerfile": "docker/Dockerfile",
      "context": ".",
      "build_contexts": {
        "agent_nebula_policy_sdk": "../agent-nebula-policy-sdk"
      },
      "enabled": true
    },
    {
      "name": "core",
      "repository": "agent-nebula-core",
      "image": "nebula-core",
      "dockerfile": "docker/nebula-core/Dockerfile",
      "context": ".",
      "build_contexts": {
        "agent_nebula_utils": "../agent-nebula-utils",
        "agent_nebula_sdk": "../agent-nebula-sdk",
        "agent_nebula_plugins": "../agent-nebula-plugins",
        "agent_nebula_policy_sdk": "../agent-nebula-policy-sdk",
        "agent_nebula_runtime": "../agent-nebula-runtime",
        "agent_nebula_connect": "../agent-nebula-connect"
      },
      "enabled": true
    },
    {
      "name": "console",
      "repository": "agent-nebula-core",
      "image": "nebula-console",
      "dockerfile": "docker/nebula-console/Dockerfile",
      "context": ".",
      "enabled": true
    },
    {
      "name": "explorer",
      "repository": "agent-nebula-explorer",
      "image": "nebula-explorer",
      "dockerfile": "docker/Dockerfile",
      "context": ".",
      "build_contexts": {
        "agent_nebula_sdk": "../agent-nebula-sdk",
        "agent_nebula_runtime": "../agent-nebula-runtime",
        "agent_nebula_connect": "../agent-nebula-connect",
        "agent_nebula_utils": "../agent-nebula-utils"
      },
      "enabled": true
    },
    {
      "name": "oauth",
      "repository": "agent-nebula-oauth",
      "image": "nebula-oauth",
      "dockerfile": "docker/Dockerfile",
      "context": ".",
      "build_contexts": {
        "agent_nebula_sdk": "../agent-nebula-sdk",
        "agent_nebula_policy_sdk": "../agent-nebula-policy-sdk",
        "agent_nebula_utils": "../agent-nebula-utils"
      },
      "enabled": true
    },
    {
      "name": "playground-container",
      "repository": "agent-nebula-playground",
      "image": "nebula-playground",
      "dockerfile": "docker/playground-container/Dockerfile",
      "context": ".",
      "build_contexts": {
        "agent_nebula_utils": "../agent-nebula-utils",
        "agent_nebula_connect": "../agent-nebula-connect",
        "agent_nebula_runtime": "../agent-nebula-runtime",
        "agent_nebula_sdk": "../agent-nebula-sdk"
      },
      "enabled": true
    },
    {
      "name": "playground-backend",
      "repository": "agent-nebula-playground",
      "image": "nebula-playground-backend",
      "dockerfile": "docker/playground-backend/Dockerfile",
      "context": ".",
      "build_contexts": {
        "agent_nebula_utils": "../agent-nebula-utils",
        "agent_nebula_connect": "../agent-nebula-connect",
        "agent_nebula_runtime": "../agent-nebula-runtime",
        "agent_nebula_sdk": "../agent-nebula-sdk"
      },
      "enabled": true
    },
    {
      "name": "playground-ui",
      "repository": "agent-nebula-playground",
      "image": "nebula-playground-ui",
      "dockerfile": "docker/playground-ui/Dockerfile",
      "context": ".",
      "enabled": true
    }
  ]
}
