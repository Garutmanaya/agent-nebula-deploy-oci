# OCI Vault identifiers consumed only by agent-nebula-deploy-oci security persistence.
ANU_OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..replace-me
ANU_OCI_VAULT_OCID=ocid1.vault.oc1.iad.replace-me
ANU_OCI_VAULT_KEY_OCID=ocid1.key.oc1.iad.replace-me
ANU_OCI_AUTH_MODE=instance_principal
ANU_OCI_SECRET_PREFIX=anu
DEPLOY_SECURITY_STAGING_ROOT=/run/agent-nebula-security-staging
