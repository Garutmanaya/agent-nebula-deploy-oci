# Legacy operator reference only. The active Cloudflare adapter derives public identities from
# canonical Agent Nebula environment values generated for PROFILE=cloudflare.

[public]
console_url = https://agentnebula.ai
registry_url = https://registry.agentnebula.ai
oauth_url = https://oauth.agentnebula.ai

[origin]
frontend_url = https://localhost:5173
backend_url = https://localhost:8000
oauth_url = https://localhost:8092
origin_server_name = localhost

[cloudflare]
tunnel_id = REPLACE_WITH_TUNNEL_UUID
credentials_file = /opt/agent-nebula/cloudflare/credentials.json
